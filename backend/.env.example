# ================= 企业 AI 知识库 · 后端配置 =================
# 复制为 .env 后修改。什么都不填也能运行（自动进入 Mock 演示模式）。

# ---------- LLM ----------
# 可选：openai / deepseek / qwen / openai_compatible / mock
# 预设会自动补全 BASE_URL 和默认模型；openai_compatible 需自行填写 BASE_URL 和 MODEL
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# LLM_TEMPERATURE=0.1

# ---------- Embedding ----------
# 可选：openai / qwen / openai_compatible / local / mock
#   local：本机运行 BAAI/bge-small-zh-v1.5（首次自动下载约 100MB，无需 Key）
#   mock ：字符哈希向量，零依赖，仅供离线演示
# 与 LLM 同一厂商时可不填 EMBEDDING_API_KEY，自动复用 LLM_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1024

# ---------- Rerank（可选）----------
# qwen：通义 gte-rerank，对召回结果精排；开启后拒答闸门改用重排分数。none：不重排
# EMBEDDING_PROVIDER=qwen 时可不填 RERANK_API_KEY，自动复用
RERANK_PROVIDER=none
RERANK_API_KEY=
# RERANK_MODEL=gte-rerank-v2
# RERANK_MIN_SCORE=0.15
# RERANK_KEEP_SIMILARITY=0.55

# ---------- RAG 参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
# 追问改写用的模型（同一厂商），留空用 LLM_MODEL。改写是简单任务，建议用非推理的快模型
# REWRITE_MODEL=deepseek-chat
# 检索方式：hybrid（向量 + BM25，RRF 融合）/ vector（纯向量）
RETRIEVAL_MODE=hybrid
# 多轮对话时先把追问改写成完整问题再检索（Mock LLM 下自动跳过）
QUERY_REWRITE=true
# 相似度阈值，低于它的切片不送给 LLM；不填按 Embedding 模型取经验值
# MIN_SCORE=0.3

# ---------- 示例 ----------
# DeepSeek 对话 + 通义 Embedding：
#   LLM_PROVIDER=deepseek   LLM_API_KEY=sk-...
#   EMBEDDING_PROVIDER=qwen EMBEDDING_API_KEY=sk-...(DashScope)
# 全部 OpenAI：
#   LLM_PROVIDER=openai EMBEDDING_PROVIDER=openai LLM_API_KEY=sk-...
# 完全离线：
#   LLM_PROVIDER=mock EMBEDDING_PROVIDER=local
